DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_id
# Optional: deploy commands instantly to one development server.
GUILD_ID=your_test_server_id
# The only Discord account allowed to create an Admin character.
ADMIN_USER_ID=your_discord_user_id
# Discord role whose members can use /admin commands (the Admin class remains owner-only).
ADMIN_ROLE_ID=your_admin_role_id
